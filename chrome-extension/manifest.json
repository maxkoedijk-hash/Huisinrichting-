{
  "manifest_version": 3,
  "name": "Postcode naar McDonald's",
  "version": "2.0.0",
  "description": "Detecteert Nederlandse postcodes (1234 AB) op webpagina's en toont de afstand tot de dichtstbijzijnde McDonald's.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://nominatim.openstreetmap.org/*",
    "https://overpass-api.de/*",
    "https://overpass.kumi.systems/*",
    "https://overpass.private.coffee/*",
    "https://maps.mail.ru/*",
    "https://www.mcdonalds.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Postcode naar McDonald's"
  }
}
